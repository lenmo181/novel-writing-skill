{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lenmo181/novel-writing-skill/schema/project_metadata.schema.json",
  "title": "小说项目元数据",
  "type": "object",
  "required": ["schema_version", "generated_by", "title", "genre", "platform", "created_date"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "generated_by": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "genre": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "target_words": {"type": "string"},
    "created_date": {"type": "string", "format": "date"}
  },
  "additionalProperties": true
}
