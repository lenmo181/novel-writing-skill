{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chapter Semantic Review Record",
  "type": "object",
  "required": ["version", "chapter", "chapter_sha256", "checks"],
  "properties": {
    "version": {"type": "string"},
    "chapter": {"type": "integer", "minimum": 1},
    "chapter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at": {"type": "string"},
    "checks": {
      "type": "object",
      "patternProperties": {
        "^(1[4-9]|2[0-9]|30)$": {
          "type": "object",
          "required": ["status", "evidence"],
          "properties": {
            "status": {"enum": ["pass", "warn", "revise", "blocked", "weak"]},
            "evidence": {
              "description": "语义证据。两种形态：(1) 字符串——描述性证据，旧格式；(2) 对象——含可验证引文锚点：text=描述，quote=正文原文摘录，offset=quote 在正文中的字符偏移。形态 (2) 由 chapter_readiness.py 服务端逐字比对，quote 与正文不符即 Gate 失败。",
              "oneOf": [
                {"type": "string", "minLength": 1},
                {
                  "type": "object",
                  "required": ["text"],
                  "properties": {
                    "text": {"type": "string", "minLength": 1},
                    "quote": {"type": "string", "minLength": 1},
                    "offset": {"type": "integer", "minimum": 0}
                  },
                  "additionalProperties": true
                }
              ]
            },
            "location": {"type": "string"},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "note": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
