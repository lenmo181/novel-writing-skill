{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chapter Semantic Review Record",
  "type": "object",
  "required": ["version", "chapter", "chapter_sha256", "checks"],
  "properties": {
    "version": {"type": "string"},
    "chapter": {"type": "integer", "minimum": 1},
    "chapter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at": {"type": "string"},
    "checks": {
      "type": "object",
      "patternProperties": {
        "^(1[4-9]|2[0-9]|30)$": {
          "type": "object",
          "required": ["status", "evidence"],
          "properties": {
            "status": {"enum": ["pass", "warn", "revise", "blocked"]},
            "evidence": {"type": "string", "minLength": 1},
            "location": {"type": "string"},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "note": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}